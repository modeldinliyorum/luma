# Luma example environment file.
#
# Luma stores no secrets and needs no network access at runtime. This file
# documents the optional build-time variables only. Copy it to `.env` if you
# want to build a signed release locally; the debug CI workflow ignores it.
#
# Release signing (unused by the debug workflow):
LUMA_KEYSTORE_PATH=
LUMA_KEYSTORE_PASSWORD=
LUMA_KEY_ALIAS=
LUMA_KEY_PASSWORD=
